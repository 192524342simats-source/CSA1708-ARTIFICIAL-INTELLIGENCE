import math

def alphabeta(depth, node, isMax, values, alpha, beta):
    if depth == 3:
        return values[node]

    if isMax:
        best = -math.inf
        for i in range(2):
            best = max(best, alphabeta(depth+1, node*2+i, False, values, alpha, beta))
            alpha = max(alpha, best)
            if beta <= alpha:
                break
        return best
    else:
        best = math.inf
        for i in range(2):
            best = min(best, alphabeta(depth+1, node*2+i, True, values, alpha, beta))
            beta = min(beta, best)
            if beta <= alpha:
                break
        return best

values = [3, 5, 6, 9, 1, 2, 0, -1]

print("Optimal Value:", alphabeta(0, 0, True, values, -math.inf, math.inf))
